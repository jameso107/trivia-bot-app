# Copy to .env.local for local dev. Values for the local stack come from
# `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (optional locally; set in Vercel for prod). Empty DSN = SDK disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# NOTE: the service-role key is the org daemon's, never the app's (CLAUDE.md
# hard rule). The app runs on anon + RLS only.
